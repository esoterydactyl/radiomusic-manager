# Copy to release.env.local (git-ignored) and fill in. Read by scripts/release.sh.

APPLE_SIGNING_IDENTITY="Developer ID Application: Ecotone Labs, LLC (HZQGLUR9QS)"

# Notarization, option A: App Store Connect API key (recommended).
# Create at App Store Connect > Users and Access > Integrations > Team Keys.
APPLE_API_ISSUER=
APPLE_API_KEY=
APPLE_API_KEY_PATH=

# Notarization, option B: Apple ID with an app-specific password
# (create one at account.apple.com). Leave APPLE_API_KEY empty to use this.
# APPLE_ID=
# APPLE_PASSWORD=
# APPLE_TEAM_ID=HZQGLUR9QS
